{
  "name": "sv-inject",
  "private": false,
  "version": "0.3.0",
  "description": "A lightweight, TypeScript-based dependency injection system designed for Astro applications with SSR support",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:vite": "vite build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "typescript",
    "astro",
    "ssr",
    "svelte"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.27",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
